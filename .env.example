# ============================================================
# MSI Audio — Environment Template
# Salin file ini menjadi `.env.local` lalu isi nilai nyata.
#   cp .env.example .env.local
# Variabel NON-prefix hanya tersedia di server (jangan akses di browser).
# Variabel NEXT_PUBLIC_* terekspos ke browser.
# ============================================================

# --- Database (Prisma / Supabase Postgres) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/msi_audio?schema=public"
# Wajib diisi bila memakai Prisma PgBouncer/connection pooling.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/msi_audio?schema=public"

# --- Supabase ---
# URL project Supabase (https://<project-ref>.supabase.co)
SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_URL=""
# anon key — aman untuk browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# service role key — SERVER ONLY, jangan pernah bocor ke browser
SUPABASE_SERVICE_ROLE_KEY=""

# --- Auth (Better Auth) ---
# Minimal 32 karakter, acak. Jangan pernah di-commit.
AUTH_SECRET=""
# Base URL untuk auth flows
AUTH_URL="http://localhost:3000"

# --- App ---
# Produksi (Vercel): wajib di-set ke domain publik agar canonical/OG/sitemap
# tidak mengarah ke domain lama (msiaudio.vercel.app):
#   NEXT_PUBLIC_APP_URL="https://msiaudio.manhajsalafinsights.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# debug | info | warn | error
LOG_LEVEL="info"

# --- Opsional ---
# YOUTUBE_API_KEY=""
# REDIS_URL=""
# CRON_SECRET=""
